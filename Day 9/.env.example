CURSOR_API_KEY=cursor_your-key-here
CURSOR_MODEL=composer-2.5
CURSOR_RUNTIME=local
# лимит контекста по умолчанию, если spawn без --limit (пусто = окно модели)
CURSOR_CONTEXT_LIMIT=
# сжатие истории по умолчанию для spawn без --compress / --no-compress
CURSOR_COMPRESS=
# порог сжатия по умолчанию (последние N как есть, старше батчами по N)
CURSOR_COMPRESS_EVERY=3
