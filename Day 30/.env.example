CURSOR_API_KEY=cursor_your-key-here
CURSOR_MODEL=qwen3.5-4b
CURSOR_RUNTIME=lmstudio
# локальная LLM (LM Studio). runtime=lmstudio не требует CURSOR_API_KEY
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MAX_TOKENS=512
# HTTP-фасад перед LM Studio (npm run llm:serve). Пустой токен — сервис не стартует.
# С другого устройства: LMSTUDIO_BASE_URL=http://<белый-ip>:8790/v1 и тот же LLM_SERVICE_TOKEN
LLM_SERVICE_HOST=0.0.0.0
LLM_SERVICE_PORT=8790
LLM_SERVICE_TOKEN=
LLM_SERVICE_QUEUE=8
LLM_SERVICE_RATE_LIMIT=10
LLM_SERVICE_MAX_CONTEXT=4096
# лимит контекста по умолчанию, если spawn без --limit (пусто = окно модели)
CURSOR_CONTEXT_LIMIT=
# сжатие истории по умолчанию для spawn без --compress / --no-compress
CURSOR_COMPRESS=
# порог сжатия по умолчанию (последние N как есть, старше батчами по N)
CURSOR_COMPRESS_EVERY=3
# стратегия контекста по умолчанию для spawn без --strategy: sliding | facts | branching | full
CURSOR_STRATEGY=
# окно последних N сообщений для sliding и facts (по умолчанию 8)
CURSOR_WINDOW=8
# хранилище профилей персонализации: file (.md/.mdc) | db (JSON) | api
PROFILE_STORAGE=file
# PROFILE_API_URL=http://127.0.0.1:8787
# PROFILE_API_TOKEN=   # необязательно: Bearer для PROFILE_STORAGE=api

